# OPENAI SETTINGS
OPENAI_API_KEY=your_openai_api_key_here

# GEMINI SETTINGS
GEMINI_API_KEY=your_gemini_api_key_here

# LOCAL LLM SETTINGS (GGUF via llama-cpp)
# Download model from: https://huggingface.co/microsoft/Phi-3-mini-4k-instruct-gguf
LOCAL_MODEL_PATH=./models/Phi-3-mini-4k-instruct-q4.gguf

# LAB CONFIG
# Options: openai | google | local | ds2api
DEFAULT_PROVIDER=openai
DEFAULT_MODEL=gpt-4o

# ReAct agent (web chat uses these; defaults to DS2API)
AGENT_PROVIDER=ds2api
AGENT_MODEL=deepseek-v4-flash
LOG_LEVEL=INFO

# DS2API (OpenAI-compatible gateway for chat UI)
DS2API_BASE_URL=https://deep-seek-api-kappa.vercel.app
DS2API_API_KEY=your_ds2api_api_key_here
DS2API_MODEL=deepseek-v4-flash
