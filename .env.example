# DEEPSEEK via DS2API (OpenAI-compatible)
DEEPSEEK_API_KEY=your_ds2api_key_here
DEEPSEEK_BASE_URL=https://deep-seek-api-kappa.vercel.app/v1

# DS2API (used by VinWonders web chat + ReAct agent)
DS2API_BASE_URL=https://deep-seek-api-kappa.vercel.app
DS2API_API_KEY=your_ds2api_api_key_here
DS2API_MODEL=deepseek-v4-flash

# OPENAI SETTINGS
OPENAI_API_KEY=your_openai_api_key_here

# GEMINI SETTINGS
GEMINI_API_KEY=your_gemini_api_key_here

# LOCAL LLM SETTINGS (GGUF via llama-cpp)
LOCAL_MODEL_PATH=./models/Phi-3-mini-4k-instruct-q4.gguf

# LAB CONFIG
# Options: deepseek | ds2api | openai | google | local
DEFAULT_PROVIDER=deepseek
DEFAULT_MODEL=deepseek-v4-flash

# OpenRouter (recommended for web chat agent)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=deepseek/deepseek-chat
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=http://localhost:8080
OPENROUTER_APP_TITLE=VinWonders Tour Guide

# ReAct agent (web chat)
# Options: openrouter | ds2api | openai | google | local
AGENT_PROVIDER=openrouter
AGENT_MODEL=deepseek/deepseek-chat

LOG_LEVEL=INFO
API_PORT=8000

# OpenWeatherMap (agent checks weather before ticket advice)
OPENWEATHER_API_KEY=your_openweather_api_key_here
