# DEEPSEEK via DS2API (OpenAI-compatible)
# Base URL must point to /v1 — see docs.txt
DEEPSEEK_API_KEY=your_ds2api_key_here
DEEPSEEK_BASE_URL=https://deep-seek-api-kappa.vercel.app/v1

# OPENAI SETTINGS
OPENAI_API_KEY=your_openai_api_key_here

# GEMINI SETTINGS
GEMINI_API_KEY=your_gemini_api_key_here

# LOCAL LLM SETTINGS (GGUF via llama-cpp)
# Download model from: https://huggingface.co/microsoft/Phi-3-mini-4k-instruct-gguf
LOCAL_MODEL_PATH=./models/Phi-3-mini-4k-instruct-q4.gguf

# LAB CONFIG
# Options: deepseek | openai | google | local
DEFAULT_PROVIDER=deepseek
DEFAULT_MODEL=deepseek-v4-flash
# For OpenAI: DEFAULT_PROVIDER=openai  DEFAULT_MODEL=gpt-4o
# For Gemini:  DEFAULT_PROVIDER=google   DEFAULT_MODEL=gemini-2.0-flash
LOG_LEVEL=INFO

# API server (for frontend UI chat)
API_PORT=8000
